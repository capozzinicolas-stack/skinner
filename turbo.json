{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "generated/**"
      ],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "ANTHROPIC_API_KEY",
        "GEMINI_API_KEY",
        "NUVEMSHOP_APP_ID",
        "NUVEMSHOP_CLIENT_SECRET",
        "NUVEMSHOP_CALLBACK_URL",
        "SHOPIFY_CLIENT_ID",
        "SHOPIFY_CLIENT_SECRET",
        "SHOPIFY_CALLBACK_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "ANTHROPIC_MODEL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "CRON_SECRET",
        "GEMINI_IMAGE_MODEL",
        "GEMINI_CLINIC_IMAGE_MODEL",
        "OPENAI_API_KEY",
        "OPENAI_CLINIC_IMAGE_MODEL",
        "OPENAI_IMAGE_QUALITY",
        "PROJECTION_QA"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
